<Window x:Class="MediaToolsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MediaToolsApp"
        mc:Ignorable="d"
        x:Name="Window"
        Title="MediaTools Application" Height="500" Width="810">

    <!--<Window.DataContext>
        <local:MainWindow/>
    </Window.DataContext>-->


    <Grid Margin="0" 
          ShowGridLines="True"
          Width="Auto"
          Height="Auto">
        <!--<Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>-->

        <TabControl x:Name="Function" 
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Margin="0"
                    Width="Auto"
                    Height="Auto"
                    MinWidth="500"
                    MinHeight="300">
            <TabItem Header="WaveForm"
                     Width="Auto"
                     Height="Auto"
                     MaxWidth="500">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Vertical">
                        <Button Margin="40, 20, 40, 20" 
                                HorizontalAlignment="Left" 
                                VerticalAlignment="Center" 
                                MinWidth="50" 
                                MaxWidth="100" 
                                MinHeight="10" 
                                MaxHeight="50" 
                                Content="Select file" 
                                Click="Button_WaveForm_AddName_Click"></Button>


                        <Label     FontWeight="Bold"
                                   Margin="40, 0, 0, 0"
                                   Width="Auto"
                                   Content="Color"></Label>
                        <ListBox   Name="Colors" 
                                   Margin="40, 0, 40, 20"
                                   MinHeight="50"
                                   MaxHeight="100"
                                   MinWidth="50"
                                   MaxWidth="100"
                                   HorizontalAlignment="Left">
                            <ListBoxItem Selected="Colors_ListBoxItem_Selected">Brown</ListBoxItem>
                            <ListBoxItem Selected="Colors_ListBoxItem_Selected">Blue</ListBoxItem>
                            <ListBoxItem Selected="Colors_ListBoxItem_Selected">Red</ListBoxItem>
                            <ListBoxItem Selected="Colors_ListBoxItem_Selected">Green</ListBoxItem>
                            <ListBoxItem Selected="Colors_ListBoxItem_Selected">Yellow</ListBoxItem>
                            <ListBoxItem Selected="Colors_ListBoxItem_Selected">Purple</ListBoxItem>
                            <ListBoxItem Selected="Colors_ListBoxItem_Selected">Pink</ListBoxItem>
                            <ListBoxItem Selected="Colors_ListBoxItem_Selected">Black</ListBoxItem>
                        </ListBox>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="40, 0, 20, 20"
                                       Width="Auto">Mix channels ?</TextBlock>
                            <CheckBox Margin="0, 0, 20, 20" 
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      x:Name="mixed"
                                      IsChecked="True"></CheckBox>
                        </StackPanel>

                        <Button Margin="40, 100, 40, 20"
                            MinHeight="10"
                            MaxHeight="50"
                            MinWidth="50"
                            MaxWidth="100"
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Bottom"
                            Content="Launch WaveForm" Click="ButtonWaveForm_Click"></Button>


                    </StackPanel>

                    <StackPanel Orientation="Vertical" 
                                Width="Auto"
                                MaxWidth="500">
                        <TextBox Margin="20, 20, 0, 0" 
                                 x:Name="Path_waveform" 
                                 FontStyle="Italic"
                                 Text="Path"></TextBox>

                        <Image x:Name="WaveForm_image" 
                               Margin="20"
                               Width="Auto">
                            <Image.Source>
                                <BitmapImage DecodePixelWidth="500"  
                                             UriSource="C:\Users\Ce PC\Documents\Ecosm\Sources\WaveForm\WaveForm\PNGs\sheep.mp4-waveform-mixed.png" />
                            </Image.Source>
                        </Image>
                    </StackPanel>


                </StackPanel>
            </TabItem>

            <TabItem Header="Shots Detection"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     Width="Auto"
                     Height="Auto"
                     x:Name="Tab_Shot">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Stretch"
                            Width="{Binding Tab_shot.ActualHeight}">
                    <StackPanel Orientation="Vertical"
                                MinWidth="100"
                                MaxWidth="300"
                                HorizontalAlignment="Stretch">
                        <Button Margin="40, 20, 40, 20" 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center" 
                                MinWidth="50" 
                                MaxWidth="100" 
                                MinHeight="10" 
                                MaxHeight="50" 
                                Content="Select file" 
                                Click="Button_Shots_AddName_Click"></Button>

                        <StackPanel Orientation="Horizontal">
                            <Label FontWeight="Bold" 
                                   Content="Threshold"
                                   Margin="40, 0, 0, 0"
                                   HorizontalAlignment="Right"></Label>
                            <TextBox Margin="20, 0, 0, 0" 
                                 MinWidth="30"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                 x:Name="Threshold"
                                 PreviewTextInput="FloatValidationTextBox"
                                 Text="0.2"></TextBox>
                        </StackPanel>


                        <Button Margin="40, 20, 40, 20"
                            MinHeight="10"
                            MaxHeight="50"
                            MinWidth="100"
                            MaxWidth="200"
                            HorizontalAlignment="Center" 
                            Content="Launch ShotDetection" Click="ButtonShots_Click"></Button>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0, 50, 0, 0">
                            <StackPanel Orientation="Vertical">
                                <Label Margin="0"  
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       Content="Number of frames"></Label>
                                <Label FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       Content="N° shot"></Label>
                            </StackPanel>

                            <StackPanel Orientation="Vertical">
                                <TextBox Margin="20, 5, 0, 10"
                                         MinWidth="20"
                                         HorizontalContentAlignment="Center"
                                         x:Name="NbFrames"
                                         PreviewTextInput="IntValidationTextBox"
                                         Text="0"></TextBox>
                                <TextBox Margin="20, 0, 0, 0"
                                         MinWidth="20"
                                         HorizontalContentAlignment="Center"
                                         x:Name="NumeroShot"
                                         PreviewTextInput="IntValidationTextBox"
                                         Text="1"></TextBox>
                            </StackPanel>

                        </StackPanel>


                        <Button Margin="40, 10, 40, 0" 
                                Click="Button_Shot"
                                HorizontalAlignment="Center"
                                Content="See shot"></Button>

                    </StackPanel>

                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Stretch"
                                x:Name="stack_shot_image">
                        <TextBox Margin="20, 20, 0, 0" 
                                 x:Name="Path_shots"
                                 HorizontalAlignment="Center"
                                 HorizontalContentAlignment="Left"
                                 FontStyle="Italic"
                                 MinWidth="300"
                                 Width="{Binding stack_shot_image.ActualWidth}"
                                 Text="Path"></TextBox>

                        <Image x:Name="Shot_image"
                               Margin="20"
                               HorizontalAlignment="Stretch"
                               Height="Auto">
                            <Image.Source>
                                <BitmapImage UriSource="C:\Users\Ce PC\Documents\Ecosm\Sources\WaveForm\WaveForm\PNGs\sheep.mp4-waveform-mixed.png" />
                            </Image.Source>
                        </Image>
                    </StackPanel>


                </StackPanel>
            </TabItem>

            <TabItem Header="Transcription">
                <StackPanel Orientation="Horizontal"
                            Width="Auto">
                    <StackPanel Orientation="Vertical">
                        <Button Margin="40, 20, 40, 20"
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center" 
                                MinWidth="50" 
                                MaxWidth="100" 
                                MinHeight="10" 
                                MaxHeight="50" 
                                Content="Select file" 
                                Click="Button_Transcription_AddName_Click"></Button>

                        <StackPanel Orientation="Vertical"
                                    Margin="20">
                            <TextBlock Text="{Binding Path=language}"/>
                            <ComboBox x:Name="LanguageCombo" 
                                      Height="Auto" 
                                      Width="Auto"
                                      MinWidth="100"
                                      ItemsSource="{Binding}" 
                                      DisplayMemberPath="Source"
                                      SelectionChanged="LanguageComboBox_SelectionChanged"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0, 20, 0, 0">

                            <StackPanel Orientation="Vertical">
                                <Label Margin="0"  
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       Content="Language"></Label>
                                <Label FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       Content="Number of speakers"></Label>
                            </StackPanel>

                            <StackPanel Orientation="Vertical">
                                <TextBox Margin="20, 5, 0, 10"
                                         MinWidth="20"
                                         HorizontalContentAlignment="Center"
                                         x:Name="Language"
                                         PreviewTextInput="IntValidationTextBox"
                                         Text="0"></TextBox>
                                <TextBox Margin="20, 0, 0, 0"
                                         MinWidth="20"
                                         HorizontalContentAlignment="Center"
                                         x:Name="NumberSpeaker"
                                         PreviewTextInput="IntValidationTextBox"
                                         Text="1"></TextBox>
                            </StackPanel>

                        </StackPanel>

                        <Button Margin="40, 100, 40, 20"
                            MinHeight="10"
                            MaxHeight="50"
                            MinWidth="100"
                            MaxWidth="200"
                            HorizontalAlignment="Center" 
                            Content="Launch Transcription" Click="ButtonTranscription_Click"></Button>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" 
                                Width="Auto"
                                MaxWidth="500">
                        <TextBox Margin="20, 20, 0, 0" 
                                 x:Name="Path_transcription" 
                                 FontStyle="Italic"
                                 Text="Path"></TextBox>

                    </StackPanel>


                </StackPanel>
            </TabItem>
        </TabControl>

        <!--<Label>Names</Label>
        <ListBox Grid.Row="1" x:Name="lstNames" />-->

    </Grid>



</Window>
